# DEV-ONLY sandbox proxy (localhost). Do NOT use in production —
# the hardened template lives in deploy/Caddyfile (phase 6).
:81 {
	handle {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}
}
