# BRUTAL//GAMES — environment template.
# Copy to .env and fill in what you need. Everything except DATABASE_URL is
# optional; the app degrades gracefully (rewards/captcha/mail stay off).

# --- required ---------------------------------------------------------------
# SQLite database file (created by `bun run db:push`)
DATABASE_URL=file:./db/custom.db

# --- core -------------------------------------------------------------------
# Public origin of the app (used in emails / links). No trailing slash.
# On Render this is optional: RENDER_EXTERNAL_URL is used when APP_URL is unset.
APP_URL=http://localhost:3000
# Secret for signing session tokens / play-session tokens. Generate with:
#   bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- admin bootstrap (scripts/seed-admin.ts — never auto-promotion) ---------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Cloudflare Turnstile (signup + payout captcha) -------------------------
# Dev/test keys that always pass:
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA
# Leave empty to disable captcha (dev).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- mail (email verification + password reset) ------------------------------
# Exactly one provider is used; Resend wins if both are set.
# Without a key, emails are logged to the server console instead of sent.
RESEND_API_KEY=
BREVO_API_KEY=
MAIL_FROM="BRUTAL//GAMES <noreply@yourdomain.com>"

# --- Google login (optional config slot) -------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- static export (GitHub Pages) --------------------------------------------
# Set only for static builds (see .github/workflows/deploy-pages.yml):
# STATIC_EXPORT=1
# NEXT_PUBLIC_BASE_PATH=/your-repo-name
