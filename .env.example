# BRUTAL//GAMES — environment template.
# Copy to .env and fill in what you need. Everything except DATABASE_URL is
# optional; the app degrades gracefully (rewards/captcha/mail stay off).
# In production (NODE_ENV=production) SESSION_SECRET is REQUIRED (>=32 chars)
# and DAILY_SALT (or SESSION_SECRET) must be set — the app refuses to boot
# with weak secrets (no code fallbacks).

# --- required ---------------------------------------------------------------
# SQLite database file (created by `bun run db:push`)
DATABASE_URL=file:./db/custom.db

# --- core -------------------------------------------------------------------
# Public origin of the app (used in emails / links). No trailing slash.
# On Render this is optional: RENDER_EXTERNAL_URL is used when APP_URL is unset.
APP_URL=http://localhost:3000
# Secret for signing session tokens / play-session tokens. Generate with:
#   bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- reverse proxy (rate limiting / audit IPs) --------------------------------
# Set to 1 when the app runs behind a reverse proxy (Caddy, Render, nginx…)
# that sets X-Forwarded-For. The client IP is then taken from the RIGHTMOST
# untrusted XFF hop (spoofed leftmost entries are ignored).
# When unset, forwarding headers are IGNORED entirely (fail-safe) and all
# direct clients share one rate-limit bucket — only correct for local dev.
TRUSTED_PROXY=1
# Optional: additional proxy IPs/CIDRs to treat as trusted hops (comma list),
# e.g. the proxy's own address when it chains. Private ranges are always
# trusted. Default: none.
TRUSTED_PROXIES=

# --- admin bootstrap (scripts/seed-admin.ts — never auto-promotion) ---------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Cloudflare Turnstile (signup + payout captcha + login escalation) ------
# Dev/test keys that always pass:
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA
# Leave empty to disable captcha (dev). When set, login demands a captcha
# after repeated failures (automatic escalation).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- password hygiene (optional) ----------------------------------------------
# Set to 1 to reject passwords found in public breach lists at signup/reset
# (HIBP k-anonymity API — only a 5-char hash prefix ever leaves the server;
# network errors fail open). Default: off.
HIBP_CHECK=

# --- board name policy (optional) ---------------------------------------------
# Extra comma-separated banned words for display names (matched on the
# leet-normalized form, on top of the built-in list). Default: built-in only.
NAME_BLOCKLIST=

# --- mail (email verification + password reset) ------------------------------
# Exactly one provider is used; Resend wins if both are set.
# Without a key, emails are logged to the server console instead of sent.
RESEND_API_KEY=
BREVO_API_KEY=
MAIL_FROM="BRUTAL//GAMES <noreply@yourdomain.com>"

# --- Google login (optional config slot) -------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- static export (GitHub Pages) --------------------------------------------
# Set only for static builds (see .github/workflows/deploy-pages.yml):
# STATIC_EXPORT=1
# NEXT_PUBLIC_BASE_PATH=/your-repo-name

# --- daily challenges ----------------------------------------------------------
# Server-side salt for daily seeds (hash(slug + dateKey + salt)). Falls back
# to SESSION_SECRET when unset. Generate with:
#   bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DAILY_SALT=

# --- anti-cheat privacy salt (optional) -----------------------------------------
# Keyed-HMAC salt for device fingerprints and IP hashes (privacy: stored
# values stay clusterable but are not reversible). Falls back to a
# SESSION_SECRET-derived key when unset.
FINGERPRINT_SALT=

# --- anti-cheat run tokens (optional) -------------------------------------------
# HMAC signing keys for run-session tokens, comma-separated "id:hexKey"
# (64 hex chars). The LAST entry signs new tokens; all entries verify
# (rotation: append new key -> deploy -> remove retired key after 24h).
# Unset: a single key is derived from SESSION_SECRET (kid "ss-v1").
# Generate a key:
#   bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RUN_TOKEN_KEYS=

# --- portal analytics (optional, privacy-friendly) ------------------------------
# Plausible/Umami-style event collector URL. When set, adapter analytics events
# (game_load, play_start, run_end, daily_*) are sent via sendBeacon.
# Leave empty to disable (nothing is tracked or stored locally).
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
NEXT_PUBLIC_ANALYTICS_SITE=
